generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  levelId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  level     Level      @relation(fields: [levelId], references: [id])
  students  Student[]
  schools   School[]
  employers Employer[]

  @@map("users")
}

model Level {
  id        String    @id @default(uuid())
  levelname String    @unique // student, school, employer
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  users     User[]

  @@map("levels")
}

model Role {
  id                  String               @id @default(uuid())
  rolename            String               @unique // principal, viceprincipal, student affair, members, treasurer, secretaris, president, vice president
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  // Relationships
  schools             School[]
  employers           Employer[]
  organizationMembers OrganizationMember[]

  @@map("roles")
}

model Grade {
  id        String    @id @default(uuid())
  gradename String    @unique // VII, VIII, IX, X, XI, XII
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  classes   Class[]

  @@map("grades")
}

model Major {
  id        String    @id @default(uuid())
  majorname String    @unique // Akuntansi Keuangan dan Lembaga, Bisnis Daring Pemasaran, Rekayasa Perangkat Lunak
  majorcode String    @unique // AKL, BDP, RPL
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  classes   Class[]

  @@map("majors")
}

model Class {
  id          String       @id @default(uuid())
  classname   String
  gradeid     String
  majorid     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  // Relationships
  grade       Grade        @relation(fields: [gradeid], references: [id])
  major       Major        @relation(fields: [majorid], references: [id])
  students    Student[]
  kasPayments KasPayment[]

  @@unique([classname, gradeid, majorid])
  @@map("classes")
}

model Student {
  id                  String               @id @default(uuid())
  userid              String
  email               String               @unique
  classid             String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  // Relationships
  user                User                 @relation(fields: [userid], references: [id], onDelete: Cascade)
  class               Class                @relation(fields: [classid], references: [id])
  organizationMembers OrganizationMember[]

  @@map("students")
}

model School {
  id        String    @id @default(uuid())
  userid    String
  email     String    @unique
  roleid    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  user      User      @relation(fields: [userid], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleid], references: [id])

  @@map("schools")
}

model Employer {
  id        String    @id @default(uuid())
  userid    String
  email     String    @unique
  roleid    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  user      User      @relation(fields: [userid], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleid], references: [id])

  @@map("employers")
}

model System {
  id            String    @id @default(uuid())
  systemname    String
  systemlogo    String?
  systemfavicon String?
  systemaddress String?
  systemcontact String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("systems")
}

model Period {
  id                  String               @id @default(uuid())
  yearLabel           String               @unique
  status              String
  voteStartDate       String?
  voteEndDate         String?
  electedCandidateId  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationMembers OrganizationMember[]
  kasPayments         KasPayment[]

  @@map("periods")
}

model Candidate {
  id                  String    @id @default(uuid())
  paslonNo            String
  name                String
  presidentId         String
  vicePresidentId     String
  presidentName       String
  vicePresidentName   String
  presidentClass      String
  vicePresidentClass  String
  classes             String
  visi                String
  misi                String?
  photo               String?
  periodId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("candidates")
}

model Vote {
  id          String   @id @default(uuid())
  userId      String
  periodId    String
  candidateId String
  createdAt   DateTime @default(now())

  @@unique([userId, periodId])
  @@map("votes")
}

model Proker {
  id          String   @id @default(uuid())
  name        String
  description String?
  targetDate  String
  status      String
  periodId    String
  candidateId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prokers")
}

model Section {
  id          String               @id @default(uuid())
  sectionname String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  members     OrganizationMember[]

  @@map("sections")
}

model OrganizationMember {
  id        String    @id @default(uuid())
  studentid String
  roleid    String
  periodid  String
  sectionid String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  student   Student   @relation(fields: [studentid], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleid], references: [id])
  period    Period    @relation(fields: [periodid], references: [id], onDelete: Cascade)
  section   Section?  @relation(fields: [sectionid], references: [id])

  @@unique([studentid, periodid])
  @@map("organization_members")
}

model KasPayment {
  id        String   @id @default(uuid())
  classId   String
  periodId  String
  month     Int
  year      Int
  amount    Int
  createdAt DateTime @default(now())

  // Relationships
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([classId, periodId, month, year])
  @@map("kas_payments")
}