generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  levelId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  level     Level      @relation(fields: [levelId], references: [id])
  students  Student[]
  schools   School[]
  employers Employer[]

  @@map("users")
}

model Level {
  id        String    @id @default(uuid())
  levelname String    @unique // student, school, employer
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  users     User[]

  @@map("levels")
}

model Role {
  id                  String               @id @default(uuid())
  rolename            String               @unique // principal, viceprincipal, student affair, members, treasurer, secretaris, president, vice president
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  // Relationships
  schools             School[]
  employers           Employer[]
  organizationMembers OrganizationMember[]

  @@map("roles")
}

model Grade {
  id        String    @id @default(uuid())
  gradename String    @unique // VII, VIII, IX, X, XI, XII
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  classes   Class[]

  @@map("grades")
}

model Major {
  id        String    @id @default(uuid())
  majorname String    @unique // Akuntansi Keuangan dan Lembaga, Bisnis Daring Pemasaran, Rekayasa Perangkat Lunak
  majorcode String    @unique // AKL, BDP, RPL
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  classes   Class[]

  @@map("majors")
}

model Class {
  id          String       @id @default(uuid())
  classname   String
  gradeid     String
  majorid     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  // Relationships
  grade       Grade        @relation(fields: [gradeid], references: [id])
  major       Major        @relation(fields: [majorid], references: [id])
  students    Student[]
  kasPayments KasPayment[]

  @@unique([classname, gradeid, majorid])
  @@map("classes")
}

model Student {
  id                  String               @id @default(uuid())
  userid              String
  email               String               @unique
  classid             String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  // Relationships
  user                User                 @relation(fields: [userid], references: [id], onDelete: Cascade)
  class               Class                @relation(fields: [classid], references: [id])
  organizationMembers OrganizationMember[]

  @@map("students")
}

model School {
  id        String    @id @default(uuid())
  userid    String
  email     String    @unique
  roleid    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  user      User      @relation(fields: [userid], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleid], references: [id])

  @@map("schools")
}

model Employer {
  id        String    @id @default(uuid())
  userid    String
  email     String    @unique
  roleid    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  user      User      @relation(fields: [userid], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleid], references: [id])

  @@map("employers")
}

model System {
  id            String    @id @default(uuid())
  systemname    String
  systemlogo    String?
  systemfavicon String?
  systemaddress String?
  systemcontact String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("systems")
}

model Period {
  id                  String               @id @default(uuid())
  yearLabel           String               @unique
  status              String
  voteStartDate       String?
  voteEndDate         String?
  electedCandidateId  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationMembers OrganizationMember[]
  kasPayments         KasPayment[]

  @@map("periods")
}

model Candidate {
  id                  String    @id @default(uuid())
  paslonNo            String
  name                String
  presidentId         String
  vicePresidentId     String
  presidentName       String
  vicePresidentName   String
  presidentClass      String
  vicePresidentClass  String
  classes             String
  visi                String
  misi                String?
  photo               String?
  periodId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("candidates")
}

model Vote {
  id          String   @id @default(uuid())
  userId      String
  periodId    String
  candidateId String
  createdAt   DateTime @default(now())

  @@unique([userId, periodId])
  @@map("votes")
}

model Proker {
  id             String          @id @default(uuid())
  name           String
  description    String?
  targetDate     String
  status         String
  periodId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relationships
  proposals      Proposal[]
  reports        Report[]
  meetings       Meeting[]
  divisions      Division[]
  members        ProkerMember[]
  documentations Documentation[]

  @@map("prokers")
}

model Proposal {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  fileName  String?
  fileSize  String?
  status    String   // 'Diajukan', 'Disetujui', 'Ditolak' or 'Submitted', 'Approved', 'Rejected'
  reason    String?
  prokerId  String
  createdAt String?
  updatedAt DateTime @updatedAt

  // Relationships
  proker    Proker   @relation(fields: [prokerId], references: [id], onDelete: Cascade)

  @@map("proposals")
}

model Report {
  id        String   @id @default(uuid())
  title     String
  summary   String?
  fileUrl   String
  fileName  String?
  fileSize  String?
  status    String   // 'Diajukan', 'Disetujui', 'Ditolak' or 'Submitted', 'Approved', 'Rejected'
  reason    String?
  prokerId  String
  createdAt String?
  updatedAt DateTime @updatedAt

  // Relationships
  proker    Proker   @relation(fields: [prokerId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Meeting {
  id          String       @id @default(uuid())
  title       String
  date        String
  description String?
  prokerId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  proker      Proker       @relation(fields: [prokerId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@map("meetings")
}

model Division {
  id        String         @id @default(uuid())
  name      String
  prokerId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Relationships
  proker    Proker         @relation(fields: [prokerId], references: [id], onDelete: Cascade)
  members   ProkerMember[]

  @@map("divisions")
}

model ProkerMember {
  id          String       @id @default(uuid())
  name        String
  role        String       // 'Koordinator', 'Anggota' or 'Coordinator', 'Member'
  divisionId  String
  prokerId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  proker      Proker       @relation(fields: [prokerId], references: [id], onDelete: Cascade)
  division    Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@map("proker_members")
}

model Attendance {
  id             String             @id @default(uuid())
  meetingId      String
  orgMemberId    String
  status         String             // PRESENT, ABSENT
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relationships
  meeting        Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  orgMember      OrganizationMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)

  @@unique([meetingId, orgMemberId])
  @@map("attendances")
}

model Documentation {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  prokerId  String
  createdAt String?
  updatedAt DateTime @updatedAt

  // Relationships
  proker    Proker   @relation(fields: [prokerId], references: [id], onDelete: Cascade)

  @@map("documentations")
}

model Section {
  id          String               @id @default(uuid())
  sectionname String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  members     OrganizationMember[]

  @@map("sections")
}

model OrganizationMember {
  id        String    @id @default(uuid())
  studentid String
  roleid    String
  periodid  String
  sectionid String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  student     Student      @relation(fields: [studentid], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleid], references: [id])
  period      Period       @relation(fields: [periodid], references: [id], onDelete: Cascade)
  section     Section?     @relation(fields: [sectionid], references: [id])
  attendances Attendance[]

  @@unique([studentid, periodid])
  @@map("organization_members")
}

model KasPayment {
  id        String   @id @default(uuid())
  classId   String
  periodId  String
  month     Int
  year      Int
  amount    Int
  createdAt DateTime @default(now())

  // Relationships
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([classId, periodId, month, year])
  @@map("kas_payments")
}

model ActivityLog {
  id        String   @id @default(uuid())
  username  String
  createdAt DateTime @default(now())
  ipAddress String
  latitude  Float?
  longitude Float?
  action    String

  @@map("activity_logs")
}

model MenuPermission {
  id        String   @id @default(uuid())
  roleName  String
  menuKey   String
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleName, menuKey])
  @@map("menu_permissions")
}